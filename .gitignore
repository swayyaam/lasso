# Dependencies
node_modules/

# Sidecar binaries — never committed. `make setup` fetches them.
# This also covers the Wails build output (build/bin/Lasso.app).
apps/desktop/build/bin/
.cache/

# Build output
dist/
build/Release/
*.app/
# main.go embeds frontend/dist, so the directory must exist for `go build` to
# work on a fresh clone even though its contents are generated.
apps/desktop/frontend/dist/*
!apps/desktop/frontend/dist/.gitkeep

# Go
*.test
*.out
# `go build ./...` drops a binary named after the directory.
/apps/desktop/desktop

# Wails bookkeeping
apps/desktop/frontend/package.json.md5

# Coverage
coverage/
coverage.out
coverage.html
*.lcov

# Environment
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
*.swp

# Turborepo
.turbo/

<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>Lasso</string>
        <key>CFBundleDisplayName</key>
        <string>Lasso</string>
        <key>CFBundleExecutable</key>
        <string>{{.OutputFilename}}</string>
        <key>CFBundleIdentifier</key>
        <string>com.swayyaam.lasso</string>
        <key>CFBundleVersion</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleShortVersionString</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleGetInfoString</key>
        <string>{{.Info.Comments}}</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>

        <!-- Lasso ships its own arm64 binaries and uses APIs that predate
             nothing older than Ventura in practice; 13.0 is the oldest macOS
             this has any claim to support. -->
        <key>LSMinimumSystemVersion</key>
        <string>13.0</string>

        <key>NSHighResolutionCapable</key>
        <true/>
        <key>LSApplicationCategoryType</key>
        <string>public.app-category.utilities</string>
        <key>NSHumanReadableCopyright</key>
        <string>{{.Info.Copyright}}</string>

        <!-- Lasso has no UI that belongs in the background and should always
             appear in the Dock. -->
        <key>LSUIElement</key>
        <false/>
    </dict>
</plist>
